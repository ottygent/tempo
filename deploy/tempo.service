[Unit]
Description=Tempo task management service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tempo
Group=tempo
EnvironmentFile=/etc/tempo/tempo.env
ExecStart=/opt/tempo/tempo -addr 127.0.0.1:8085 -data /var/lib/tempo/tempo.json -auth-file /var/lib/tempo/auth.json
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tempo
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
